# ============================================================
# OHMY ONE — Environment Variables (EXAMPLE)
# Copy to `.env` and fill in. NEVER commit the real `.env`.
# ============================================================

# --- Supabase project ---
# From: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Service role key: SERVER-SIDE ONLY. Bypasses RLS. Never ship to a browser
# or an LLM. The MCP server uses it ONLY to run SECURITY DEFINER RPCs after
# the permission engine has authorized the caller.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Direct Postgres connection (migrations, tests) ---
# Local dev via `supabase start` typically:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- MCP server ---
# The MCP server authenticates the human whose conversation it serves.
# In the prototype the identity is supplied via a signed session token; in
# production this is an OIDC/Supabase-Auth access token. See docs/SECURITY.md.
OHMY_MCP_SESSION_SECRET=change-me-dev-only-secret
OHMY_ENV=development

# --- Admin console (Next.js) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
